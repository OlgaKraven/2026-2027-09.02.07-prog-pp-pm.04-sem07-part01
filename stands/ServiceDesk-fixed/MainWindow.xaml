<Window x:Class="ServiceDeskWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сервисный журнал учебного центра" Width="1040" Height="610" MinWidth="800" MinHeight="480"
        Background="White" FontFamily="Segoe UI" FontSize="14" Language="ru-RU">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="Контрольная дата" VerticalAlignment="Center" Margin="0,0,12,0" />
      <DatePicker x:Name="ControlDate" Width="160" SelectedDateFormat="Short"
                  SelectedDateChanged="ControlDate_Changed" AutomationProperties.Name="Контрольная дата" />
      <CheckBox x:Name="FlexibleHeader" Content="Столбцы по именам (расширение)" VerticalAlignment="Center" Margin="24,0,0,0" />
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="Тестовые данные" Click="LoadTestData_Click" />
      <Button Content="Открыть CSV" Click="OpenCsv_Click" />
      <Button Content="Экспорт CSV" Click="SaveCsv_Click" />
      <Button Content="Просрочено" Click="CountOverdue_Click" />
      <Button Content="Для оператора" Click="SelectForOperator_Click" />
      <Button Content="Все записи" Click="ShowAll_Click" />
    </WrapPanel>
    <DataGrid x:Name="TicketsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" RowHeight="34" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70" />
        <DataGridTextColumn Header="Объект" Binding="{Binding Item}" Width="*" />
        <DataGridTextColumn Header="Ответственный" Binding="{Binding Owner}" Width="*" />
        <DataGridTextColumn Header="Срок" Binding="{Binding Due, StringFormat=dd.MM.yyyy}" Width="140" />
        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,16,0,0" Text="Загрузить встроенные данные для первой проверки" />
  </Grid>
</Window>
